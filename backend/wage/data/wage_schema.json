{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifiedWageDataset",
  "type": "object",
  "required": ["version", "jurisdiction", "last_updated", "records"],
  "properties": {
    "version": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "last_updated": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "schedule_name",
          "occupation_titles",
          "skill_classification",
          "applicable_zone",
          "effective_from",
          "effective_to",
          "wage_period",
          "basic_wage_monthly",
          "vda_monthly",
          "total_minimum_wage_monthly",
          "total_minimum_wage_daily",
          "statutory_hours_per_day",
          "working_days_per_month_basis",
          "legal_authority",
          "notification_number",
          "source_url",
          "verification_status",
          "verified_by",
          "verification_date",
          "verification_notes"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "schedule_name": { "type": "string" },
          "occupation_titles": { "type": "array", "items": { "type": "string" } },
          "skill_classification": { "type": "string", "enum": ["unskilled", "semi_skilled", "skilled", "highly_skilled"] },
          "applicable_zone": { "type": "string" },
          "effective_from": { "type": "string" },
          "effective_to": { "type": "string" },
          "wage_period": { "type": "string", "enum": ["monthly", "daily"] },
          "basic_wage_monthly": { "type": "number", "minimum": 0 },
          "vda_monthly": { "type": "number", "minimum": 0 },
          "total_minimum_wage_monthly": { "type": "number", "minimum": 0 },
          "total_minimum_wage_daily": { "type": "number", "minimum": 0 },
          "statutory_hours_per_day": { "type": "integer", "minimum": 1 },
          "working_days_per_month_basis": { "type": "integer", "minimum": 1 },
          "legal_authority": { "type": "string" },
          "notification_number": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "verification_status": { "type": "string", "enum": ["verified", "unverified", "draft"] },
          "verified_by": { "type": "string" },
          "verification_date": { "type": "string" },
          "verification_notes": { "type": "string" }
        }
      }
    }
  }
}
